{
  "name": "shapegrid",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "GitHub activity visualizer - fit exact-count square/hex grids inside any boundary, rendered in 3D WebGL",
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @shapegrid/web build",
    "dev": "pnpm --filter @shapegrid/cli dev",
    "dev:web": "pnpm --filter @shapegrid/web dev",
    "generate": "node packages/core/cli/dist/index.js generate",
    "typecheck": "pnpm -r typecheck",
    "typecheck:web": "pnpm --filter @shapegrid/web typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "js-yaml": "^5.2.2",
    "three": "^0.185.1",
    "yargs": "^18.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "gl"
    ]
  }
}
